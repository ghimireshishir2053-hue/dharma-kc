# Krishi Bank persistence — any Postgres works (Vercel Postgres, Neon, Supabase).
# Create a database, then paste its connection string here and in your
# Vercel project's Environment Variables. After setting it, run:
#   npx prisma migrate dev --name init
DATABASE_URL=

# Sparrow SMS (https://sparrowsms.com) — Nepal SMS gateway used to notify
# registered buyers when a matching farmer listing comes in.
# Sign up, grab your API token from the dashboard, and set the sender
# identity Sparrow assigned you.
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# Admin portal (/admin) — required, no insecure default. Pick a real
# username/password, and generate ADMIN_TOKEN_SECRET with:
#   openssl rand -hex 32
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
